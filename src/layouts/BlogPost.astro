---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post-page { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 24px 80px; }
			.post-header { display: grid; width: 100%; grid-template-columns: minmax(0, 1fr) minmax(220px, 0.38fr); gap: 40px; align-items: end; padding: 90px 0 58px; }
			.post-header h1 { width: 100%; max-width: 100%; margin: 0; font-size: clamp(44px, 7vw, 88px); font-weight: 700; letter-spacing: -0.07em; line-height: 0.95; overflow-wrap: anywhere; text-wrap: balance; }
			.post-dek { margin: 0 0 5px; color: rgb(var(--gray)); font-size: 17px; line-height: 1.5; }
			.post-meta { margin: 0 0 20px; color: rgb(var(--accent-dark)); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; }
			.hero-image { overflow: hidden; border-radius: 24px; background: #e9edf4; box-shadow: var(--box-shadow); }
			.hero-image img { display: block; width: 100%; aspect-ratio: 2 / 1; object-fit: cover; outline: 1px solid rgba(0, 0, 0, 0.1); outline-offset: -1px; }
			.prose { width: 700px; max-width: 100%; margin: 64px auto 0; color: rgb(var(--gray-dark)); font-size: 18px; line-height: 1.75; }
			.prose :global(h2) { margin: 2.6em 0 0.55em; color: rgb(var(--black)); font-size: 32px; letter-spacing: -0.045em; line-height: 1.1; text-wrap: balance; }
			.prose :global(h3) { margin: 2em 0 0.5em; color: rgb(var(--black)); font-size: 24px; letter-spacing: -0.03em; }
			.prose :global(p) { margin: 0 0 1.3em; text-wrap: pretty; }
			.prose :global(ul), .prose :global(ol) { margin: 0 0 1.4em; padding-left: 1.2em; }
			.prose :global(li) { padding-left: 0.25em; }
			.prose :global(blockquote) { margin: 2em 0; padding: 0 0 0 1.2em; border-left: 3px solid var(--accent); color: rgb(var(--gray)); font-size: 1.05em; }
			.prose :global(pre) { margin: 2em -80px; border-radius: 16px; }
			.prose :global(code) { padding: 0.12em 0.3em; border-radius: 5px; background: rgb(var(--gray-light)); font-size: 0.86em; }
			.prose :global(pre code) { padding: 0; background: transparent; }
			.prose :global(a) { color: var(--accent-dark); text-decoration: underline; text-decoration-thickness: 0.08em; text-underline-offset: 0.16em; }
			@media (max-width: 720px) {
				.post-page { padding: 0 16px 56px; }
				.post-header { display: block; max-width: 100%; padding: 58px 0 36px; }
				.post-header h1 { font-size: 44px; overflow-wrap: break-word; text-wrap: wrap; }
				.post-dek { margin-top: 26px; }
				.prose { margin-top: 40px; font-size: 17px; }
				.prose :global(h2) { font-size: 28px; }
				.prose :global(pre) { margin-right: 0; margin-left: 0; overflow-x: auto; }
			}
		</style>
	</head>

	<body>
		<main class="post-page">
			<Header />
			<article>
				<header class="post-header">
					<div><p class="post-meta"><FormattedDate date={pubDate} />{updatedDate && ` · Updated ${updatedDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}`}</p><h1>{title}</h1></div>
					<p class="post-dek">{description}</p>
				</header>
				{heroImage && <div class="hero-image"><img width={1020} height={510} src={heroImage} alt="" /></div>}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
