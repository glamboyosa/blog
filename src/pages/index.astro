---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection, CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import { getReadingMinutes } from "../utils/readingTime";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
) as CollectionEntry<"blog">[];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class="home-shell">
      <Header />
      <section class="home-intro">
        <p class="eyebrow"><a href="https://glamboyosa.xyz" target="_blank" rel="noopener noreferrer">Osa's notes</a></p>
        <h1>Things I am <em>figuring out.</em></h1>
        <p class="intro-copy">A small archive of technical deep dives, product lessons, and the occasional detour.</p>
      </section>
      <section class="post-archive" aria-labelledby="archive-heading">
        <div class="section-heading">
          <h2 id="archive-heading">Latest notes</h2>
          <span>{posts.length} posts</span>
        </div>
        <div class="post-grid">
          {
            posts.map((post) => (
              <a href={`/blog/${post.slug}/`} class="post-card">
                <div class="post-card-image">
                  <img src={post.data.heroImage} alt="" loading="lazy" />
                  <span>Read note <span aria-hidden="true">↗</span></span>
                </div>
                <div class="post-card-meta">
                  <FormattedDate date={post.data.pubDate} />
                  <span aria-hidden="true">·</span>
                  <span>{getReadingMinutes(post.body)} min read</span>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            ))
          }
        </div>
      </section>
      <Footer />
    </main>
  </body>
</html>
